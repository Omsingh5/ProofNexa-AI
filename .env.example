# Copy to .env (never commit the real file)

MYSQL_DATABASE=proofora
MYSQL_USER=proofora
MYSQL_PASSWORD=proofora
MYSQL_ROOT_PASSWORD=proofora-root

JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
GITHUB_TOKEN=

# Local debugging only. When true, forgot-password returns the reset token in JSON.
# Leave false unless you are on your own machine and email delivery is not configured.
PROOFORA_EXPOSE_RESET_TOKEN=false
