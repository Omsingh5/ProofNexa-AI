server {
  listen __PORT__;
  server_name _;
  root /usr/share/nginx/html;
  client_max_body_size 10m;

  location /api/ {
    proxy_pass http://127.0.0.1:8080;
    proxy_read_timeout 90s;
  }

  location /actuator/ {
    proxy_pass http://127.0.0.1:8080;
  }

  location / {
    try_files $uri /index.html;
  }
}
